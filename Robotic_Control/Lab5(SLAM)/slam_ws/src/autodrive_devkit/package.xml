<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>autodrive_f1tenth</name>
  <version>0.1.0</version>
  <description>AutoDRIVE Ecosystem ROS 2 Package for F1TENTH</description>

  <maintainer email="tsamak@clemson.edu">Tanmay Vilas Samak</maintainer>
  <maintainer email="csamak@clemson.edu">Chinmay Vilas Samak</maintainer>

  <license>BSD</license>

  <url type="repository">https://autodrive-ecosystem.github.io</url>
  <url type="repository">https://github.com/Tinker-Twins/AutoDRIVE</url>
  <url type="bugtracker">https://github.com/Tinker-Twins/AutoDRIVE/issues</url>

  <author email="tsamak@clemson.edu">Tanmay Vilas Samak</author>
  <author email="csamak@clemson.edu">Chinmay Vilas Samak</author>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>tf_transformations</depend>

  <!--
    Pip only dependencies (no rosdep key available), see
    requirements_python_3.10.txt in this package and install with:
      pip install -r requirements_python_3.10.txt
    Pinned versions matter here: this bridge speaks an older Socket.IO
    and Engine.IO protocol version to match the AutoDRIVE Simulator's
    Unity client. Newer python-socketio/python-engineio will fail to
    handshake with it.
  -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
